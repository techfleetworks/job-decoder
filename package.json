{
  "name": "job-decoder",
  "private": true,
  "version": "0.2.0",
  "description": "Hat Check: read a job posting against the Tech Fleet Skills and Practices Framework and see the role responsibilities it really expects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bdd": "cucumber-js",
    "bdd:index": "node scripts/gen-bdd-index.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:gherkin": "node scripts/check-gherkin-valid.mjs",
    "check:bdd-tags": "node scripts/check-bdd-tags.mjs",
    "check:bdd-coverage": "node scripts/check-bdd-coverage.mjs",
    "check:bdd-executed": "node scripts/check-bdd-executed.mjs",
    "sync:framework": "node pipeline/sync-framework.mjs",
    "build:snapshot": "node pipeline/build-snapshot.mjs --source=supabase",
    "build:snapshot:local": "node pipeline/build-snapshot.mjs --source=local",
    "check:snapshot-integrity": "node pipeline/build-snapshot.mjs --source=local --out=.snapshot-check"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.1",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/material": "^5.16.7",
    "@mui/material-nextjs": "^5.16.6",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/gherkin": "^30.0.4",
    "@cucumber/messages": "^27.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
