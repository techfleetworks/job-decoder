# Copy this file to .env and fill in the values. Never commit a real .env.
# These are server-only secrets. They live in Vercel's server environment and in the
# GitHub Actions secrets, never in a client bundle (ADR-0006, ADR-0009).

# The data tier (Supabase). Needed only to sync the framework into Supabase and to
# build the snapshot from the published release. The local snapshot build does not use
# them. The service-role key bypasses row-level security, so it is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the pinned framework commit the sync stamps onto a release.
# Defaults to the pin in pipeline/lib/manifest.mjs.
# FRAMEWORK_SHA=

# The LLM step (OpenRouter), used by the decode route (added with the decode engine,
# T05). Server-only.
# OPENROUTER_API_KEY=
