# Copy this file to .env and fill in the values. Never commit a real .env.
# These are server-only secrets. They live in Vercel's server environment and in the
# GitHub Actions secrets, never in a client bundle (ADR-0006, ADR-0009).

# The data tier (Supabase). Needed only to sync the framework into Supabase and to
# build the snapshot from the published release. The local snapshot build does not use
# them. The service-role key bypasses row-level security, so it is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the pinned framework commit the sync stamps onto a release.
# Defaults to the pin in pipeline/lib/manifest.mjs.
# FRAMEWORK_SHA=

# The LLM step (OpenRouter), used by the eval harness now and by the decode route when the
# grounded recognizer lands (T03/T05). Server-only: it lives in Vercel's server env and in
# GitHub Actions secrets, never in a client bundle, and never in Supabase (no Supabase
# function calls OpenRouter). See ADR-0007 and ADR-0036.
# OPENROUTER_API_KEY=

# Which model to use. Default is DeepSeek Chat v3-0324, a NON-reasoning instruct model picked
# for the 8s interactive budget (ADR-0050): the deepseek *flash* variants are reasoning models
# (~50s/call) that the budget aborts to keyword-only. DeepSeek the company is based in China,
# so the model is pinned to the US-based inference provider below.
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Comma-separated OpenRouter provider allow-list. The request is restricted to these
# providers with no fallback, and data collection is always denied, so the posting only
# ever reaches a US-based provider (or the call fails and we fall back to keyword-only).
# "gmicloud" (GMI Cloud, Mountain View CA) is the US company that serves deepseek-chat-v3-0324;
# the model's only other provider, siliconflow, is a China company and is excluded. Add another
# slug only after confirming it on the model's OpenRouter page.
# Honest limit: OpenRouter does not expose a provider's datacenter country, so this pins to
# US-based provider companies, not a guaranteed US datacenter (ADR-0036).
# OPENROUTER_PROVIDERS=gmicloud
